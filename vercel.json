{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "NITRO_PRESET=vercel npm run build",
  "outputDirectory": "apps/web/.vercel/output",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://networkpeer-staging-api-alb-969746120.eu-north-1.elb.amazonaws.com/api/v1/:path*"
    }
  ]
}